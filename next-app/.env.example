# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

NODE_ENV="developpement"

NEXT_BASE_URL="http://localhost:3000"

#Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"
AUTH_SECRET="utiliser 'openssl rand -base64 32' dans un terminal pour générer une valeur aléatoire pour celui-ci"

# Google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Envoi de mail
SMTP_HOST="mailhog" # « mailhog » = e-mails dans Mailhog ; un vrai serveur = vrais e-mails, même en dev
SMTP_PORT=1025 # Pour Docker SMTP_PORT=1025 sinon SMTP_PORT=465
SMTP_USER="contact@exemple.com"
SMTP_PASS="password"
MAILER_FROM_ADDRESS="contact@exemple.com"
MAILER_TO_ADDRESS="destinataire@exemple.com"

# Upload API
# URL du service vue par le serveur Next.js (dans Docker : nom du service)
UPLOAD_API_URL="http://upload-service:8000"
NEXT_PUBLIC_SERVER_DOMAIN_API="http://upload-service:8000"
# URL du service vue par le navigateur
NEXT_PUBLIC_CLIENT_DOMAIN_API="http://localhost:8000"
# Clé partagée avec le service d'upload (même valeur des deux côtés).
# Générer avec : openssl rand -base64 32
UPLOAD_API_KEY=""
